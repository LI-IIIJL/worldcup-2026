<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Round + Date + Confidence -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_pred_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_pred_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="10sp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tv_confidence_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_badge"
            android:textColor="#FFD700"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Teams & Score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_team_a"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_pred_score_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E94560"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:minWidth="48dp" />

        <TextView
            android:id="@+id/tv_team_b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Probability bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <View
            android:id="@+id/bar_team_a"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:background="#E94560" />

        <View
            android:id="@+id/bar_draw"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:background="#555555" />

        <View
            android:id="@+id/bar_team_b"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:background="#4CAF50" />
    </LinearLayout>

    <!-- Prob percentages -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_team_a_prob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="#E94560"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/tv_draw_prob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center"
            android:minWidth="48dp" />

        <TextView
            android:id="@+id/tv_team_b_prob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MC stats row: ELO + λ + Most Likely -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_elo_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#666666"
            android:textSize="10sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_mc_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="10sp"
            android:background="@drawable/bg_round_tag"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Stars -->
    <TextView
        android:id="@+id/tv_stars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFD700"
        android:textSize="11sp"
        android:paddingTop="4dp"
        android:visibility="gone" />
</LinearLayout>
