<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Date header -->
    <TextView
        android:id="@+id/tv_date_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8888AA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <!-- Match card -->
    <LinearLayout
        android:id="@+id/match_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_ripple"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <!-- Status band indicator (left) -->
        <View
            android:id="@+id/status_band"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="#888888" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Round + Status tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_round_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#555577"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_status_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" />
            </LinearLayout>

            <!-- Teams + Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <!-- Time -->
                <TextView
                    android:id="@+id/tv_match_time"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:textColor="#8888AA"
                    android:textSize="12sp"
                    android:gravity="center" />

                <!-- Home team -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical"
                    android:layout_marginStart="6dp">
                    <ImageView
                        android:id="@+id/iv_home_flag"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_flag_circle"
                        android:scaleType="fitCenter"
                        android:padding="3dp" />
                    <TextView
                        android:id="@+id/tv_home_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Score -->
                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:minWidth="44dp" />

                <!-- Away team -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:id="@+id/tv_away_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingEnd="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <ImageView
                        android:id="@+id/iv_away_flag"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_flag_circle"
                        android:scaleType="fitCenter"
                        android:padding="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
