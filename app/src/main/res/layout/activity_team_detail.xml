<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F23"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/team_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== Header ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 球队"
                android:textColor="#E94560"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="16dp" />
            <ImageView
                android:id="@+id/iv_team_flag"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_flag_circle" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">
                <TextView
                    android:id="@+id/tv_team_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/tv_team_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E94560"
                        android:textSize="12sp"
                        android:background="@drawable/bg_round_tag"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                    <TextView
                        android:id="@+id/tv_team_en_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:paddingStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 球队附加信息 ==================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_team_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_team_elo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#8888AA"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/divider_extra_1"
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#2A2A4E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_team_stadium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#8888AA"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/divider_extra_2"
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#2A2A4E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_team_squad_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#8888AA"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== Divider ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A3E" />

        <!-- ==================== 球队统计 ==================== -->
        <LinearLayout
            android:id="@+id/ll_team_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:visibility="gone">

            <!-- 已赛 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_matches_played"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已赛"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 胜 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_wins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="胜"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 平 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_draws"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="平"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 负 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_losses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E94560"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="负"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 进 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_goals_for"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 失 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_goals_against"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="失"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 战绩概要 -->
        <TextView
            android:id="@+id/tv_record_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone" />

        <!-- ==================== BDL 球队数据 ==================== -->
        <LinearLayout
            android:id="@+id/ll_bdl_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 球队数据（场均）"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/bdl_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ==================== 射门热力图 ==================== -->
        <LinearLayout
            android:id="@+id/ll_shot_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_shot_map_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 射门热力图"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <FrameLayout
                android:id="@+id/fl_shot_map"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- ==================== Divider ==================== -->
        <View
            android:id="@+id/divider_form"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A3E"
            android:visibility="gone" />

        <!-- ==================== 近况 Section ==================== -->
        <LinearLayout
            android:id="@+id/form_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="近况"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:id="@+id/form_row_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- ==================== Divider ==================== -->
        <View
            android:id="@+id/divider_schedule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A3E"
            android:visibility="gone" />

        <!-- ==================== 赛程 Section ==================== -->
        <LinearLayout
            android:id="@+id/schedule_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 赛程"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:id="@+id/schedule_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- ==================== Divider ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A3E" />

        <!-- ==================== 阵容 Section ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👥 阵容"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_squad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
