<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F23"
    android:fitsSystemWindows="true">

    <!-- 返回按钮 -->
    <TextView
        android:id="@+id/tv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← 返回"
        android:textColor="#2ECC71"
        android:textSize="14sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- ═══════ 第1层：头像 + 信息 ═══════ -->
            <LinearLayout
                android:id="@+id/player_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- 头像 -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ImageView
                        android:id="@+id/iv_player_avatar"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_flag_circle" />

                    <!-- 号码标 -->
                    <TextView
                        android:id="@+id/tv_player_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#FF6B35"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginBottom="-4dp"
                        android:layout_marginEnd="-4dp" />
                </FrameLayout>

                <!-- 信息列 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/tv_player_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_player_name_en"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8888AA"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_player_position"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#00CC66"
                            android:textSize="12sp"
                            android:background="@drawable/bg_round_tag"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />

                        <TextView
                            android:id="@+id/tv_injury_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:layout_marginStart="6dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_player_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#BB86FC"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tv_player_club"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#8888AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_market_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFD700"
                            android:textSize="11sp"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 球员ID（调试信息） -->
            <TextView
                android:id="@+id/tv_player_ids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444466"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <!-- ═══════ 第2层：快速统计条 ═══════ -->
            <LinearLayout
                android:id="@+id/quick_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#1A1A3E"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_data_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555577"
                android:textSize="9sp"
                android:gravity="center"
                android:paddingBottom="12dp" />

            <!-- ═══════ 第3层：世界杯累计统计 ═══════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 世界杯累计"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/career_stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A3E"
                android:padding="12dp" />

            <!-- ═══════ 第4层：赛季详细18项统计 ═══════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔬 赛季详细统计"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <ViewStub
                android:id="@+id/season_stats_stub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/section_season_stats" />

            <!-- ═══════ 第5层：五维雷达图 ═══════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 能力雷达"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/radar_chart_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1A1A3E"
                android:padding="16dp" />

            <!-- ═══════ 第7层：射门分布图 ═══════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 射门分布"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/shot_map_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1A1A3E"
                android:padding="8dp"
                android:minHeight="200dp" />

            <!-- ═══════ 第8层：生涯荣誉 ═══════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆 生涯荣誉"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/honors_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1A3E"
                android:padding="12dp" />

            <!-- 数据来源 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 数据来源: players_2026.json + football-data API + api-sports API + trophies_cache.json"
                android:textColor="#555577"
                android:textSize="10sp"
                android:gravity="center"
                android:padding="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
